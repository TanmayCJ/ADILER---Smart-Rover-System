# Backend Configuration - Example (.env.example)

# Server Configuration
FASTAPI_ENV=development
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Logging
LOG_LEVEL=info

# Dataset Configuration
DATASETS_CACHE_DIR=./datasets/cache
DATASETS_PDS_API=https://pds-geosciences.wustl.edu/mro/mro-m-hirise-3-dtm-v1/

# Terrain Data
TERRAIN_MOLA_URL=https://pds-geosciences.wustl.edu/mro/
TERRAIN_HIRISE_URL=https://www.uahirise.org/dtm/
TERRAIN_CTX_URL=https://pds-geosciences.wustl.edu/mro/mro-m-ctx-3/

# Simulation Parameters
ROVER_MAX_SPEED=0.5  # m/s
ROVER_MAX_SLOPE=30   # degrees
ROVER_WHEEL_SIZE=0.25  # meters

# API Settings
API_VERSION=v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
API_TITLE=Mars Rover AI Simulator API
API_DESCRIPTION=Backend API for Mars terrain visualization and autonomous rover simulation

# Database (future)
DATABASE_URL=sqlite:///./rovers.db

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600  # seconds

# AI Brain Service (when implemented)
AI_BRAIN_SERVICE_URL=http://localhost:8001
