{
  "scenario_id": "memory_hazard",
  "description": "Known hazard in memory; expect avoidance behavior.",
  "initial_state": {
    "rover_position": {
      "latitude": -75.751,
      "longitude": 45.004,
      "elevation_m": -2232.0
    },
    "heading": 60.0,
    "goal_position": {
      "latitude": -75.746,
      "longitude": 45.011,
      "name": "Hazard Edge",
      "priority": 9
    },
    "hazard_memory": [
      {
        "hazard_type": "obstacle",
        "severity": 0.8,
        "location": {"lat": -75.749, "lon": 45.006},
        "recommendation": "Avoid the boulder field in this area."
      }
    ]
  },
  "environment_inputs": {
    "terrain_query": {
      "endpoint": "/api/v1/terrain/elevation",
      "request": {
        "latitude": -75.751,
        "longitude": 45.004,
        "dataset_id": "DTE_022534_1120_021534_1120_UA00"
      }
    },
    "wind_query": {
      "endpoint": "/api/v1/wind/query",
      "request": {
        "latitude": -75.751,
        "longitude": 45.004,
        "sol": 850,
        "timestamp_utc": null,
        "dataset_id": null
      }
    },
    "terrain_enrichment": {
      "source": "fallback",
      "fallback": true,
      "method": "memory_hazard_context",
      "payload": {
        "slope_deg": 5.0,
        "terrain_type": "mixed",
        "roughness": 0.3,
        "obstacles": []
      }
    }
  },
  "expected_behavior": {
    "expected_risk_level": "medium",
    "expected_decision_type": "detour",
    "expected_action": "moving"
  },
  "validation_rules": [
    {
      "id": "memory-avoid",
      "description": "Hazard memory should remain populated after the cycle",
      "when": {"field": "workflow_result.state.hazard_memory.0.severity", "op": ">=", "value": 0.5},
      "assert": {"field": "workflow_result.state.hazard_memory.0.hazard_type", "op": "==", "value": "obstacle"}
    }
  ]
}
