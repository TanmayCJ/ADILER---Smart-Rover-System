{
  "scenario_id": "high_wind",
  "description": "High wind speed; expect reduced speed or pause.",
  "initial_state": {
    "rover_position": {
      "latitude": -75.749,
      "longitude": 45.002,
      "elevation_m": -2230.0
    },
    "heading": 120.0,
    "goal_position": {
      "latitude": -75.744,
      "longitude": 45.008,
      "name": "Wind Gap",
      "priority": 5
    }
  },
  "environment_inputs": {
    "terrain_query": {
      "endpoint": "/api/v1/terrain/elevation",
      "request": {
        "latitude": -75.749,
        "longitude": 45.002,
        "dataset_id": "DTE_022534_1120_021534_1120_UA00"
      }
    },
    "wind_query": {
      "endpoint": "/api/v1/wind/query",
      "request": {
        "latitude": -75.749,
        "longitude": 45.002,
        "sol": 850,
        "timestamp_utc": null,
        "dataset_id": null
      }
    },
    "terrain_enrichment": {
      "source": "fallback",
      "fallback": true,
      "method": "wind_override",
      "payload": {
        "slope_deg": 4.0,
        "terrain_type": "sand",
        "roughness": 0.2,
        "obstacles": []
      }
    }
  },
  "expected_behavior": {
    "expected_risk_level": "medium",
    "expected_decision_type": "slow",
    "expected_action": "moving"
  },
  "validation_rules": [
    {
      "id": "wind-risk",
      "description": "High wind should increase risk",
      "when": {"field": "agent_outputs.environment_analysis.wind_data.speed_mps", "op": ">=", "value": 12.0},
      "assert": {"field": "agent_outputs.environment_analysis.hazard_map.risk_score", "op": ">=", "value": 0.55}
    }
  ]
}
