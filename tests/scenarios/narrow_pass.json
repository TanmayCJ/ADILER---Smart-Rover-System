{
  "scenario_id": "narrow_pass",
  "description": "Narrow rocky pass with scattered obstacles; expect detour planning.",
  "initial_state": {
    "rover_position": {
      "latitude": -75.751,
      "longitude": 45.009,
      "elevation_m": -2225.0
    },
    "heading": 330.0,
    "goal_position": {
      "latitude": -75.744,
      "longitude": 45.015,
      "name": "Narrow Pass Exit",
      "priority": 6
    }
  },
  "environment_inputs": {
    "terrain_query": {
      "endpoint": "/api/v1/terrain/elevation",
      "request": {
        "latitude": -75.751,
        "longitude": 45.009,
        "dataset_id": "DTE_022534_1120_021534_1120_UA00"
      }
    },
    "wind_query": {
      "endpoint": "/api/v1/wind/query",
      "request": {
        "latitude": -75.751,
        "longitude": 45.009,
        "sol": 850,
        "timestamp_utc": null,
        "dataset_id": null
      }
    },
    "terrain_enrichment": {
      "source": "fallback",
      "fallback": true,
      "method": "pass_obstacles",
      "payload": {
        "slope_deg": 14.0,
        "terrain_type": "rock",
        "roughness": 0.6,
        "obstacles": [
          {"type": "rock", "distance_m": 9.0, "size_m": 2.5},
          {"type": "rock", "distance_m": 14.0, "size_m": 1.8}
        ]
      }
    }
  },
  "expected_behavior": {
    "expected_risk_level": "medium",
    "expected_decision_type": "detour",
    "expected_action": "moving"
  },
  "validation_rules": [
    {
      "id": "pass-obstacles",
      "description": "Obstacles in a narrow pass should keep risk in mid range",
      "when": {"field": "agent_outputs.environment_analysis.terrain_data.obstacles.0.type", "op": "!=", "value": null},
      "assert": {"field": "agent_outputs.environment_analysis.hazard_map.risk_score", "op": ">=", "value": 0.4}
    }
  ]
}
