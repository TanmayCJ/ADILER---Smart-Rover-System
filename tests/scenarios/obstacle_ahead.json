{
  "scenario_id": "obstacle_ahead",
  "description": "Obstacle directly ahead; expect detour route.",
  "initial_state": {
    "rover_position": {
      "latitude": -75.75,
      "longitude": 45.0,
      "elevation_m": -2234.5
    },
    "heading": 90.0,
    "goal_position": {
      "latitude": -75.745,
      "longitude": 45.012,
      "name": "Rocky Spur",
      "priority": 7
    }
  },
  "environment_inputs": {
    "terrain_query": {
      "endpoint": "/api/v1/terrain/elevation",
      "request": {
        "latitude": -75.75,
        "longitude": 45.0,
        "dataset_id": "DTE_022534_1120_021534_1120_UA00"
      }
    },
    "wind_query": {
      "endpoint": "/api/v1/wind/query",
      "request": {
        "latitude": -75.75,
        "longitude": 45.0,
        "sol": 850,
        "timestamp_utc": null,
        "dataset_id": null
      }
    },
    "terrain_enrichment": {
      "source": "fallback",
      "fallback": true,
      "method": "manual_obstacle_override",
      "payload": {
        "slope_deg": 6.0,
        "terrain_type": "rock",
        "roughness": 0.35,
        "obstacles": [
          {"type": "boulder", "distance_m": 12.0, "size_m": 2.0}
        ]
      }
    }
  },
  "expected_behavior": {
    "expected_risk_level": "medium",
    "expected_decision_type": "detour",
    "expected_action": "moving"
  },
  "validation_rules": [
    {
      "id": "obstacle-detour",
      "description": "Detected obstacle should discourage straight line",
      "when": {"field": "agent_outputs.environment_analysis.terrain_data.obstacles.0.type", "op": "!=", "value": null},
      "assert": {"field": "agent_outputs.planner_output.current_action", "op": "!=", "value": "waiting_for_goal"}
    }
  ]
}
